# Copy this file to .env.local for local development (never commit
# .env.local — it's already in .gitignore). In production, set these
# same names as Environment Variables in the Vercel dashboard instead.

# ---- Exposed to the frontend (safe to expose — not secret) ----
# Your Supabase project URL. Used to build public product image URLs.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "publishable" key, exposed to the browser this time.
# Used only for the Google OAuth redirect handshake and the password
# reset page — both flows Supabase requires to happen client-side.
# Safe to expose: protected by Row Level Security either way.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Server-side only (used by the /api serverless functions) ----
# Same project URL, read on the server side.
SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "publishable" key from Supabase Settings -> API.
# Safe-ish (RLS protects the data either way) but only ever used
# server-side here, never sent to the browser directly by us.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The "service_role" / "secret" key from Supabase Settings -> API.
# NEVER expose this to the frontend, never commit it, never paste it
# anywhere outside Vercel's environment variable settings. It bypasses
# all Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Your real deployed site origin (no trailing slash). Used to lock
# down CORS so only your own site can call these API endpoints with
# credentials.
PUBLIC_SITE_ORIGIN=https://xtreme-doors.vercel.app
